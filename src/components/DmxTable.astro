---
// src/components/DmxTable.astro
interface DmxRange {
  value: string;
  description: string;
}

interface DmxChannel {
  channel: number | string;
  function: string;
  ranges: DmxRange[];
}

interface Props {
  channels: DmxChannel[];
}

const { channels } = Astro.props as Props;
---

<div class="table-wrapper">
  <table class="dmx-table">
    <thead>
      <tr>
        <th>DMX Channel</th>
        <th>Function</th>
        <th>DMX Value</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {channels.map((ch) => (
        ch.ranges.map((range, index) => (
          <tr>
            {/* Only render the Channel and Function cells on the first row of a range, spanning downwards */}
            {index === 0 && (
              <td rowspan={ch.ranges.length} class="channel-num"><strong>{ch.channel}</strong></td>
            )}
            {index === 0 && (
              <td rowspan={ch.ranges.length}>{ch.function}</td>
            )}
            
            {/* Render Value and Description for every row */}
            <td>{range.value}</td>
            <td>{range.description}</td>
          </tr>
        ))
      ))}
    </tbody>
  </table>
</div>

<style>
  .table-wrapper {
    overflow-x: auto;
    margin-top: 1rem;
  }
  .dmx-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .dmx-table th {
    background-color: var(--sl-color-gray-6);
    text-align: left;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
  }
  .dmx-table td {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    vertical-align: top;
  }
  .channel-num {
    text-align: center;
  }
</style>